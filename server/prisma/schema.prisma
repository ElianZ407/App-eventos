generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              Int         @id @default(autoincrement())
  nombre          String?
  email           String?     @unique
  password        String?
  rol             String      @default("Organizador")
  telefono        String?
  emailVerificado DateTime?   @map("email_verificado")
  eventos         Evento[]
  cuentas         Cuenta[]
  sesiones        Sesion[]
  fechaCreacion   DateTime    @default(now()) @map("fecha_creacion")

  @@map("usuarios")
}

model Cuenta {
  id                 Int     @id @default(autoincrement())
  usuarioId          Int     @map("usuario_id")
  tipo               String
  proveedor          String
  proveedorCuentaId  String  @map("proveedor_cuenta_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([proveedor, proveedorCuentaId])
  @@map("cuentas")
}

model Sesion {
  id            Int      @id @default(autoincrement())
  tokenSesion   String   @unique @map("token_sesion")
  usuarioId     Int      @map("usuario_id")
  expira        DateTime
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sesiones")
}

model TokenVerificacion {
  identificador String
  token         String   @unique
  expira        DateTime

  @@unique([identificador, token])
  @@map("tokens_verificacion")
}

enum TipoEvento {
  Boda
  XV_Anos
  Cumpleaños
  Bautizo
  Graduacion
  Conferencia
  Corporativo
  Fiesta_Privada
  Otro
}

model Evento {
  id                  Int        @id @default(autoincrement())
  nombre              String
  fecha               DateTime
  hora                String
  tipo                TipoEvento @default(Otro)
  descripcion         String?    @db.Text
  totalInvitados      Int        @map("total_invitados")
  
  // Ubicación
  lugarNombre         String?    @map("lugar_nombre")
  direccion           String?
  ciudad              String?
  codigoPostal        String?    @map("codigo_postal")
  pais                String     @default("España")
  lugarTelefono       String?    @map("lugar_telefono")
  puntoReferencia     String?    @map("punto_referencia") @db.Text
  
  // Ajustes / Organizador
  nombreOrganizador   String?    @map("nombre_organizador")
  emailOrganizador    String?    @map("email_organizador")
  telefonoOrganizador String?    @map("telefono_organizador")
  codigoVestimenta    String?    @map("codigo_vestimenta")
  notasEspeciales     String?    @map("notas_especiales") @db.Text
  
  estado              String     @default("proximo")
  usuarioId           Int        @map("usuario_id")
  usuario             Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  invitados           Invitado[]
  mesas               Mesa[]
  fechaCreacion       DateTime   @default(now()) @map("fecha_creacion")
  fechaActualizacion  DateTime   @updatedAt @map("fecha_actualizacion")

  @@map("eventos")
}

model Invitado {
  id              Int            @id @default(autoincrement())
  nombre          String
  email           String?
  telefono        String?
  estado          String         @default("pendiente") // confirmado, pendiente, cancelado
  eventoId        Int            @map("evento_id")
  evento          Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  mesaId          Int?           @map("mesa_id")
  mesa            Mesa?          @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  invitaciones    Invitacion[]

  @@map("invitados")
}

model Mesa {
  id              Int        @id @default(autoincrement())
  numero          Int
  capacidad       Int
  ubicacion       String?
  estado          String     @default("vacia") // llena, parcial, vacia
  eventoId        Int        @map("evento_id")
  evento          Evento     @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  invitados       Invitado[]

  @@map("mesas")
}

model Invitacion {
  id              Int        @id @default(autoincrement())
  invitadoId      Int        @map("invitado_id")
  invitado        Invitado   @relation(fields: [invitadoId], references: [id], onDelete: Cascade)
  estado          String     @default("enviada")
  fechaEnvio      DateTime   @default(now()) @map("fecha_envio")
  fechaApertura   DateTime?  @map("fecha_apertura")
  fechaClick      DateTime?  @map("fecha_click")

  @@map("invitaciones")
}
